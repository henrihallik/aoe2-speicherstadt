#const FAR_MAINLAND_ZONE 12
#const CENTRAL_ISLAND_ZONE 20
#const NEAR_UPPER_BRIDGE_ZONE 31
#const NEAR_MIDDLE_BRIDGE_ZONE 32
#const NEAR_LOWER_BRIDGE_ZONE 33
#const FAR_UPPER_BRIDGE_ZONE 34
#const FAR_MIDDLE_BRIDGE_ZONE 35
#const FAR_LOWER_BRIDGE_ZONE 36
#const CORNER_FOREST_ZONE 40
#const WATER_RESOURCE_ZONE 50
#const CENTRAL_RESOURCE_ZONE 60

/* Actor areas used only for fair placement separation. */
#const TC_AREA 1000
#const VILLAGER_ANCHOR_AREA 1010
#const BERRIES_AREA 1100
#const PRIMARY_GOLD_AREA 1110
#const FORWARD_GOLD_AREA 1120
#const TERTIARY_GOLD_AREA 1130
#const PRIMARY_STONE_AREA 1140
#const FORWARD_STONE_AREA 1150
#const SAFE_WOOD_AREA 1200
#const FORWARD_WOOD_AREA 1210

/* Rotate the complete topology between games. */
start_random
    percent_chance 50 #define VERTICAL_CANALS
    percent_chance 50 #define HORIZONTAL_CANALS
end_random

/* Neither player color is tied to a side of the map. */
start_random
    percent_chance 50 #define PLAYER_ONE_NEAR_ORIGIN
    percent_chance 50 #define PLAYER_TWO_NEAR_ORIGIN
end_random


<PLAYER_SETUP>

direct_placement
behavior_version 2
ai_info_map_type RIVERS 0 0 0

/* Standard Garrison-style 9-villager quick-start resources. */
effect_amount MOD_RESOURCE AMOUNT_STARTING_WOOD ATTR_ADD -30
effect_amount MOD_RESOURCE AMOUNT_STARTING_FOOD ATTR_ADD -100


<LAND_GENERATION>

base_terrain HARBOR_WATER
enable_waves 0

/* In AoE2, 100 fully respects land borders; 0 would ignore them. */

if VERTICAL_CANALS

    /* Western mainland. */
    create_land {
        terrain_type PLAYER_GROUND
        land_percent 100
        base_size 16
        land_position 18 50
        left_border 0
        right_border 65
        top_border 0
        bottom_border 0
        border_fuzziness 100
        clumping_factor 100
        other_zone_avoidance_distance 0
        zone NEAR_MAINLAND_ZONE
        land_id NEAR_MAINLAND_ID
        if PLAYER_ONE_NEAR_ORIGIN
            assign_to_player 1
        else
            assign_to_player 2
        endif
