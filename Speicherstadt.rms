/* Compatibility: Definitive Edition */
/*
    Speicherstadt v0.6.0
    The Garrison 2026 map competition release candidate.

    Designed for:
      - 1v1 Random Map
      - Tiny map (the normal two-player size)
      - Standard resources
      - 9-villager quick start

    Layout:
      - Two mirrored player districts face a long central warehouse island.
      - Two navigable canals wrap around the island and join at both ends.
      - Three shallow crossings span each canal, creating six bridge fronts.
      - The island lets armies switch lanes and holds contested gold, stone,
        relics, wood, and two ruined church landmarks.
      - Each player has equal home fish and identical starting resources.

    Competitive integrity:
      - No unit or building attributes are changed.
      - No triggers, XS, custom includes, capturable buildings, or income
        mechanics are used.
      - The only player effects are the established quick-start adjustments
        of -30 starting wood and -100 starting food.
*/

/* Terrain aliases. */
#const PLAYER_GROUND 12
#const PLAYER_DETAIL 6
#const CENTRAL_GROUND 11
#const CENTRAL_DETAIL 25
#const HARBOR_WATER 1
#const BRIDGE_GROUND 4
#const OAK_FOREST 10

/* Object aliases. */
#const START_HERDABLE 594
#const START_LUREABLE 48
#const START_HUNTABLE 65
#const START_TREE 349
#const HARBOR_FISH 457
#const CHURCH_RUIN 1517

/* Stable land identifiers. */
#const NEAR_MAINLAND_ID 101
#const FAR_MAINLAND_ID 102
#const CENTRAL_ISLAND_ID 200
#const NEAR_UPPER_BRIDGE_ID 301
#const NEAR_MIDDLE_BRIDGE_ID 302
#const NEAR_LOWER_BRIDGE_ID 303
#const FAR_UPPER_BRIDGE_ID 304
#const FAR_MIDDLE_BRIDGE_ID 305
#const FAR_LOWER_BRIDGE_ID 306
