/* The remaining island objectives use the original central land. */
create_object RELIC {
    number_of_objects 5
    set_gaia_object_only
    place_on_specific_land_id CENTRAL_ISLAND_ID
    avoid_other_land_zones 2
    min_distance_group_placement 8
    force_placement
}

