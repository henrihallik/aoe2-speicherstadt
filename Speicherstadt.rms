<CONNECTION_GENERATION>

/*
    Each crossing has its own zone. These narrow passes replace only water at
    the four joins in each lane, closing engine-generated seams without carving
    extra routes through either mainland or the island.
*/

/* Upper lane. */
create_connect_land_zones NEAR_MAINLAND_ZONE NEAR_UPPER_BRIDGE_ZONE {
    replace_terrain HARBOR_WATER BRIDGE_GROUND
    terrain_cost HARBOR_WATER 12
    terrain_cost BRIDGE_GROUND 1
    terrain_cost PLAYER_GROUND 1
    terrain_cost CENTRAL_GROUND 1
    terrain_size HARBOR_WATER 2 0
}

