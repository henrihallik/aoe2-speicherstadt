/* Normal Gaia rubble: visual church landmarks with no modified behavior. */
create_object CHURCH_RUIN {
    number_of_objects 1
    number_of_groups 2
    group_placement_radius 1
    set_gaia_object_only
    place_on_specific_land_id CENTRAL_ISLAND_ID
    avoid_other_land_zones 2
    find_closest_to_map_edge
    ignore_terrain_restrictions
    min_distance_group_placement 42
}
